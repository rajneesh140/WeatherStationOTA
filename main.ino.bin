#include <Wire.h>
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>
#include "DFRobot_RainfallSensor.h"

#include "esp_sleep.h"
#include "driver/gpio.h"
#include "driver/rtc_io.h"
#include "esp_wifi.h"
#include "esp_bt.h"

// =====================================================
// TFT PINS
// =====================================================
#define TFT_CS   5
#define TFT_RST  4
#define TFT_DC   16
#define TFT_BL   33

// =====================================================
// WAKE / SLEEP BUTTON
// BUTTON BETWEEN GPIO 12 AND GND
// =====================================================
#define BUTTON_PIN 12

// =====================================================
// I2C
// =====================================================
#define I2C_SDA 21
#define I2C_SCL 22

// =====================================================
// TFT
// =====================================================
Adafruit_ST7735 tft = Adafruit_ST7735(
  TFT_CS,
  TFT_DC,
  TFT_RST
);

// =====================================================
// RAIN SENSOR
// =====================================================
DFRobot_RainfallSensor_I2C Sensor(&Wire);

// =====================================================
// VARIABLES
// =====================================================
float sensorWorkingTime = 0.0;
float rainfall = 0.0;

uint32_t tipCount = 0;

unsigned long sensorTimer = 0;

bool lastButtonState = HIGH;

const unsigned long SENSOR_INTERVAL = 1000;

// =====================================================
// FUNCTION PROTOTYPES
// =====================================================
void readRainSensor();
void updateDisplay();
void goToSleep();
void waitForButtonRelease();

// =====================================================
// READ SENSOR
// =====================================================
void readRainSensor()
{
  sensorWorkingTime = Sensor.getSensorWorkingTime();
  rainfall = Sensor.getRainfall();
  tipCount = Sensor.getRawData();

  Serial.print("Rainfall: ");
  Serial.print(rainfall, 2);
  Serial.print(" mm");

  Serial.print(" | Tip Count: ");
  Serial.print(tipCount);

  Serial.print(" | Sensor Time: ");
  Serial.print(sensorWorkingTime, 2);

  Serial.println(" H");
}

// =====================================================
// DISPLAY
// =====================================================
void updateDisplay()
{
  tft.fillScreen(ST77XX_BLACK);

  // TITLE
  tft.setTextColor(ST77XX_CYAN);
  tft.setTextSize(2);
  tft.setCursor(5, 5);
  tft.print("RAIN GAUGE");

  tft.drawLine(
    0,
    25,
    127,
    25,
    ST77XX_BLUE
  );

  // RAINFALL
  tft.setTextColor(ST77XX_YELLOW);
  tft.setTextSize(1);
  tft.setCursor(5, 35);
  tft.print("RAINFALL");

  tft.setTextColor(ST77XX_WHITE);
  tft.setTextSize(2);
  tft.setCursor(5, 48);
  tft.print(rainfall, 2);

  tft.setTextSize(1);
  tft.print(" mm");

  // TIP COUNT
  tft.setTextColor(ST77XX_GREEN);
  tft.setTextSize(1);
  tft.setCursor(5, 75);
  tft.print("TIP COUNT");

  tft.setTextColor(ST77XX_WHITE);
  tft.setTextSize(2);
  tft.setCursor(75, 71);
  tft.print(tipCount);

  tft.drawLine(
    0,
    95,
    127,
    95,
    ST77XX_BLUE
  );

  // SENSOR TIME
  tft.setTextColor(ST77XX_CYAN);
  tft.setTextSize(1);
  tft.setCursor(5, 103);
  tft.print("TIME");

  tft.setTextColor(ST77XX_WHITE);
  tft.setCursor(45, 103);
  tft.print(sensorWorkingTime, 2);
  tft.print(" H");

  // STATUS
  tft.setTextColor(ST77XX_GREEN);
  tft.setCursor(5, 118);
  tft.print("D12: SLEEP");
}

// =====================================================
// WAIT BUTTON RELEASE
// =====================================================
void waitForButtonRelease()
{
  while (digitalRead(BUTTON_PIN) == LOW)
  {
    delay(10);
  }

  delay(100);

  lastButtonState = HIGH;
}

// =====================================================
// VERY LOW POWER DEEP SLEEP
// =====================================================
void goToSleep()
{
  Serial.println();
  Serial.println("Preparing VERY LOW POWER sleep...");

  // ===================================================
  // WAIT BUTTON RELEASE
  // ===================================================
  waitForButtonRelease();

  // ===================================================
  // CLEAR TFT
  // ===================================================
  tft.fillScreen(ST77XX_BLACK);

  delay(50);

  // ===================================================
  // PUT ST7735 CONTROLLER INTO SLEEP
  // ===================================================
  tft.enableDisplay(false);

  delay(10);

  // ===================================================
  // BACKLIGHT OFF
  // ===================================================
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, LOW);

  // ===================================================
  // HOLD BACKLIGHT LOW
  // ===================================================
  gpio_hold_en(GPIO_NUM_33);

  gpio_deep_sleep_hold_en();

  // ===================================================
  // END I2C
  // ===================================================
  Wire.end();

  // ===================================================
  // SPI PINS TO LOW POWER STATE
  // ===================================================
  pinMode(TFT_CS, OUTPUT);
  digitalWrite(TFT_CS, HIGH);

  pinMode(TFT_DC, OUTPUT);
  digitalWrite(TFT_DC, LOW);

  pinMode(TFT_RST, OUTPUT);
  digitalWrite(TFT_RST, LOW);

  // ===================================================
  // TURN WIFI OFF
  // ===================================================
  esp_wifi_stop();

  // ===================================================
  // TURN BLUETOOTH OFF
  // ===================================================
  esp_bt_controller_disable();

  // ===================================================
  // CONFIGURE RTC WAKE PIN
  // ===================================================
  rtc_gpio_init(GPIO_NUM_12);

  rtc_gpio_set_direction(
    GPIO_NUM_12,
    RTC_GPIO_MODE_INPUT_ONLY
  );

  // INTERNAL RTC PULL-UP
  rtc_gpio_pullup_en(GPIO_NUM_12);

  rtc_gpio_pulldown_dis(GPIO_NUM_12);

  // ===================================================
  // WAKE WHEN GPIO 12 = LOW
  // ===================================================
  esp_sleep_enable_ext0_wakeup(
    GPIO_NUM_12,
    0
  );

  // ===================================================
  // ISOLATE UNUSED RTC GPIOs
  // ===================================================
  rtc_gpio_isolate(GPIO_NUM_34);
  rtc_gpio_isolate(GPIO_NUM_35);

  Serial.println("Backlight OFF");
  Serial.println("TFT sleeping");
  Serial.println("I2C stopped");
  Serial.println("WiFi stopped");
  Serial.println("Bluetooth stopped");
  Serial.println("GPIO12 wake enabled");

  Serial.println("Entering DEEP SLEEP");

  Serial.flush();

  delay(50);

  // ===================================================
  // DEEP SLEEP
  // ===================================================
  esp_deep_sleep_start();
}

// =====================================================
// SETUP
// =====================================================
void setup()
{
  Serial.begin(115200);

  delay(300);

  // ===================================================
  // RELEASE DEEP SLEEP GPIO HOLD
  // ===================================================
  gpio_deep_sleep_hold_dis();

  gpio_hold_dis(GPIO_NUM_33);

  // ===================================================
  // RELEASE RTC GPIO
  // ===================================================
  rtc_gpio_deinit(GPIO_NUM_12);

  // ===================================================
  // BUTTON
  // ===================================================
  pinMode(
    BUTTON_PIN,
    INPUT_PULLUP
  );

  // ===================================================
  // WAKE REASON
  // ===================================================
  esp_sleep_wakeup_cause_t wakeReason =
    esp_sleep_get_wakeup_cause();

  if (wakeReason == ESP_SLEEP_WAKEUP_EXT0)
  {
    Serial.println("Wakeup by GPIO12 Button");
  }
  else
  {
    Serial.println("Normal Power ON");
  }

  // ===================================================
  // BACKLIGHT ON
  // ===================================================
  pinMode(TFT_BL, OUTPUT);

  digitalWrite(TFT_BL, HIGH);

  // ===================================================
  // I2C
  // ===================================================
  Wire.begin(
    I2C_SDA,
    I2C_SCL
  );

  // ===================================================
  // TFT
  // ===================================================
  tft.initR(
    INITR_144GREENTAB
  );

  tft.setRotation(0);

  tft.enableDisplay(true);

  tft.fillScreen(ST77XX_BLACK);

  // ===================================================
  // START SCREEN
  // ===================================================
  tft.setTextColor(ST77XX_CYAN);

  tft.setTextSize(2);

  tft.setCursor(5, 35);

  tft.print("RAIN GAUGE");

  tft.setTextColor(ST77XX_WHITE);

  tft.setTextSize(1);

  tft.setCursor(30, 70);

  tft.print("Reading...");

  // ===================================================
  // SENSOR INIT
  // ===================================================
  while (!Sensor.begin())
  {
    Serial.println("Rain Sensor Init Error!");

    tft.fillScreen(ST77XX_BLACK);

    tft.setTextColor(ST77XX_RED);

    tft.setTextSize(1);

    tft.setCursor(10, 50);

    tft.print("SENSOR ERROR!");

    delay(1000);
  }

  Serial.println("Rain Sensor Connected");

  // ===================================================
  // CALIBRATION
  // ===================================================
  Sensor.setRainAccumulatedValue(
    0.28
  );

  Serial.println(
    "Rain Calibration = 0.28 mm/tip"
  );

  // ===================================================
  // FIRST READ
  // ===================================================
  readRainSensor();

  updateDisplay();

  sensorTimer = millis();

  // ===================================================
  // WAIT WAKE BUTTON RELEASE
  // ===================================================
  waitForButtonRelease();
}

// =====================================================
// LOOP
// =====================================================
void loop()
{
  // ===================================================
  // SENSOR UPDATE
  // ===================================================
  if (
    millis() - sensorTimer >= SENSOR_INTERVAL
  )
  {
    sensorTimer = millis();

    readRainSensor();

    updateDisplay();
  }

  // ===================================================
  // BUTTON
  // ===================================================
  bool buttonState =
    digitalRead(BUTTON_PIN);

  if (
    buttonState == LOW &&
    lastButtonState == HIGH
  )
  {
    delay(50);

    if (
      digitalRead(BUTTON_PIN) == LOW
    )
    {
      Serial.println(
        "GPIO12 Button Pressed"
      );

      goToSleep();
    }
  }

  lastButtonState = buttonState;

  delay(10);
}
